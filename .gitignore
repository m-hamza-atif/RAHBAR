# Secrets: never committed, created with kubectl create secret (section 4.7)
.env
.env.*
*-secret.yaml
*secret*.yaml
kubeconfig
# ...except a placeholder that documents the Secret's shape (values: REPLACE_ME).
# Never list it in kustomization.yaml: applying it would overwrite the real Secret.
!*placeholder*.yaml

# Corpus files you did not write: commit corpus/MANIFEST.md and corpus/fetch.py instead
corpus/raw/

# Python
__pycache__/
*.pyc
.venv/
.venv-wsl/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local scratch
*.log
.DS_Store

# Personal viva notes (not submission artifacts)
VIVA_GUIDE*.md
RUN.md
corpus/**/*.pdf

# Local tooling and runtime output
.tools/
.artifacts/
k8s/overlays/local/
